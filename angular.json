{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "tomomomento": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/popup/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": ["src/popup/styles.css"],
            "index": "src/popup/index.html",
            "outputPath": {
              "base": "dist",
              "browser": ""
            },
            "deleteOutputPath": false,
            "outputHashing": "none"
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "300kB",
                  "maximumError": "600kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "10kB",
                  "maximumError": "12kB"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "web": {
              "browser": "src/web/main.ts",
              "index": "src/web/index.html",
              "styles": ["src/web/styles.css"],
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": ["manifest.json", "options.html", "offscreen.html", "blocked.*"]
                },
                {
                  "glob": "**/*",
                  "input": "src/web/public"
                }
              ],
              "outputPath": {
                "base": "dist-web",
                "browser": ""
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tsconfig.spec.json"
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "tomomomento:build:development,web"
          }
        }
      }
    }
  }
}
